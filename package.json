{
  "name": "brobot",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "A Minecraft Java companion with a bounded OpenAI agent and local game controls",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "play": "node --env-file-if-exists=.env scripts/play.js",
    "setup": "node scripts/setup.js",
    "server:setup": "node --env-file-if-exists=.env scripts/server.js setup",
    "server:update-bridge": "node --env-file-if-exists=.env scripts/server.js update-bridge",
    "server": "node --env-file-if-exists=.env scripts/server.js start",
    "doctor": "node --env-file-if-exists=.env scripts/doctor.js",
    "test": "node --test test/*.test.js",
    "test:live": "node --env-file-if-exists=.env scripts/smoke.js",
    "check": "node scripts/check.js",
    "benchmark:controls": "node scripts/benchmark-controls.js",
    "benchmark:skills": "node scripts/benchmark-skills.js",
    "benchmark:survival": "node scripts/benchmark-survival.js"
  },
  "dependencies": {
    "mineflayer": "4.39.0",
    "mineflayer-pathfinder": "2.4.5",
    "mineflayer-tool": "1.2.0",
    "openai": "7.23.0",
    "vec3": "0.1.10"
  }
}
