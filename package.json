{
  "name": "brobot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A local-first, offline-capable Minecraft Java bot with automation, commands, and a dashboard.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flowzygames/BroBot.git"
  },
  "homepage": "https://github.com/flowzygames/BroBot#readme",
  "bugs": {
    "url": "https://github.com/flowzygames/BroBot/issues"
  },
  "keywords": [
    "minecraft",
    "mineflayer",
    "automation",
    "bot",
    "typescript",
    "local-first"
  ],
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:watch": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "mineflayer": "4.37.1",
    "mineflayer-auto-eat": "5.0.3",
    "mineflayer-pathfinder": "2.4.5",
    "mineflayer-tool": "1.2.0",
    "vec3": "0.1.10"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
