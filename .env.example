# Minecraft stays on this computer; no port forwarding.
MC_HOST=127.0.0.1
MC_PORT=25565
MC_VERSION=1.21.8
MC_USERNAME=BroBot
MC_AUTH=offline
# Your exact Minecraft name. Blank disables in-game control.
MC_OWNER=
BEDROCK_PORT=19132
MC_SERVER_MEMORY=2G
# Optional: direct commands work without an API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
AI_MAX_REQUESTS=30
AI_MAX_INPUT_TOKENS=120000
AI_MAX_OUTPUT_TOKENS=30000
AI_TURN_OUTPUT_TOKENS=2000
AI_STEP_LIMIT=40
AI_INTERVAL_MS=3000
ACTION_TIMEOUT_MS=120000
WEB_PORT=3000
# Optional absolute Java 21+ executable path:
JAVA_PATH=
